# Rename this file to .env. Edit all placeholders before accepting real registrations.
PORT=3000
PUBLIC_BASE_URL=https://your-real-domain.com
EVENT_NAME=St. George’s Sunrise Run & Walk
EVENT_DATE_DISPLAY=Friday, 4 December 2026
EVENT_LOCATION=St. George’s Heights · East Doboro, Ghana
CONTACT_EMAIL=
CONTACT_PHONE=

# Direct transfer to an official business MoMo wallet, confirmed manually.
MOMO_NUMBER=
MOMO_NAME=
MOMO_NETWORK=MTN Mobile Money

# Optional automated MoMo checkout. Do not expose this key in browser code.
# A verified Paystack business account is required; settlement goes to the merchant's configured account.
PAYSTACK_SECRET_KEY=

# Confirmed by organisers: one general admission price for both routes.
PRICE_GENERAL=80

# Admin: set a long unique password and randomly generated session secret.
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PRIVATE_PASSWORD
SESSION_SECRET=REPLACE_WITH_A_RANDOM_64_CHARACTER_HEX_SECRET
DATA_DIR=./data

# Must be false before any public launch. In test mode, registration works without real payment info.
TEST_MODE=false

# Change this when legal and medical reviewers approve the declaration.
WAIVER_VERSION=DRAFT-2026-11-15-v1
